Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar
      Enabled: true
      Topic:
        Value: /lidar_points
        Reliability Policy: Best Effort
        Depth: 1
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Channel Name: intensity
      Use rainbow: true
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 60
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Gauge points
      Enabled: true
      Topic:
        Value: /obstacle/points
        Reliability Policy: Reliable
        Depth: 5
        History Policy: Keep Last
        Durability Policy: Volatile
      Style: Spheres
      Size (m): 0.15
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacles
      Enabled: true
      Topic:
        Value: /obstacle/markers
        Reliability Policy: Reliable
        Depth: 5
        History Policy: Keep Last
        Durability Policy: Volatile
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 28
    Fixed Frame: hesai_lidar
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Focal Point:
        X: 0
        Y: -40
        Z: 0
      Pitch: 0.35
      Yaw: 1.5708
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
